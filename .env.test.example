# E2E Test Environment Variables
# Copy this to .env.test and fill in the values

# Clerk Test Mode
# Get from Clerk Dashboard > API Keys > Testing Token
CLERK_TESTING_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# E2E Auth Bypass Token (for seeding users directly)
# Generate a secure random string
E2E_AUTH_BYPASS_TOKEN=afters-e2e-bypass-secret-change-me

# Neon Database (for test branch management)
NEON_API_KEY=
NEON_PROJECT_ID=

# Base database URL (test branches will be created from this)
DATABASE_URL=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Other required env vars (copy from your .env.local)
SCANNER_JWT_SECRET=test-scanner-secret-change-me
UPLOADTHING_TOKEN=
RESEND_API_KEY=
