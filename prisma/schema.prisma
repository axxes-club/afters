generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPERADMIN
  ORGANIZER
  ARTIST
  PERSONAL
}

model User {
  id               String            @id
  email            String            @unique
  username         String?           @unique
  firstName        String?
  lastName         String?
  imageUrl         String?
  bio              String?
  role             UserRole          @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  follows          Follow[]
  orders           Order[]
  organizerProfile OrganizerProfile?
  artistProfile    ArtistProfile?
  personalProfile  PersonalProfile?
  savedEvents      SavedEvent[]
  tickets          Ticket[]
}

// Personal profile for regular users (/p/<username>)
model PersonalProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  slug        String   @unique
  bio         String?
  avatarUrl   String?
  coverUrl    String?
  websiteUrl  String?
  twitterUrl  String?
  instagramUrl String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Artist profile for DJs/producers (/a/<slug>)
model ArtistProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  artistName     String
  slug           String        @unique
  bio            String?
  avatarUrl      String?
  coverUrl       String?
  genres         String?
  spotifyUrl     String?
  soundcloudUrl  String?
  instagramUrl   String?
  twitterUrl     String?
  websiteUrl     String?
  youtubeUrl     String?
  isVerified     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  radioTracks    RadioTrack[]
}

// Organization model (separate from OrganizerProfile for event companies)
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  websiteUrl  String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String   @default("US")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// AFTERS RADIO Models
enum RadioTrackStatus {
  PENDING
  APPROVED
  REJECTED
}

model RadioTrack {
  id              String           @id @default(cuid())
  artistId        String?
  title           String
  artistName      String?          // For admin-uploaded tracks without artist profile
  fileUrl         String
  duration        Int              // Duration in seconds
  artworkUrl      String?
  genre           String?
  bpm             Int?
  status          RadioTrackStatus @default(PENDING)
  queuePosition   Int?             // Position in the radio queue (null = not in queue)
  rejectionReason String?
  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  uploadedBy      String?          // Admin who uploaded the track
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  artist          ArtistProfile?   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  plays           RadioPlay[]

  @@index([status])
  @@index([artistId])
  @@index([queuePosition])
}

model RadioPlay {
  id        String     @id @default(cuid())
  trackId   String
  playedAt  DateTime
  listeners Int        @default(1)
  createdAt DateTime   @default(now())
  track     RadioTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, playedAt])
  @@index([playedAt])
}

// Radio schedule for synchronized playback
model RadioSchedule {
  id           String   @id @default(cuid())
  dayOfWeek    Int      // 0-6 (Sunday-Saturday)
  startTime    String   // HH:mm format
  trackOrder   String[] // Array of track IDs in order
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([dayOfWeek, startTime])
}

enum FeatureType {
  EVENTS
  DASHBOARD
  LOGIN
  REGISTRATION
  TICKETING
  PROFILE
  PAYMENTS
  API
}

model SystemStatus {
  id          String       @id @default(cuid())
  feature     String
  featureType FeatureType
  status      SystemHealth @default(OPERATIONAL)
  message     String?
  plannedEnd  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([feature, featureType])
}

enum SystemHealth {
  OPERATIONAL
  MAINTENANCE
  DEPRECATED
  CONSTRUCTION
  DEPLOYING
  DOWN
}

model OrganizerProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  displayName              String
  slug                     String   @unique
  bio                      String?
  logoUrl                  String?
  stripeAccountId          String?  @unique
  stripeOnboardingComplete Boolean  @default(false)
  stripeChargesEnabled     Boolean  @default(false)
  stripePayoutsEnabled     Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  artistType               String?
  coverUrl                 String?
  genres                   String?
  instagramUrl             String?
  soundcloudUrl            String?
  spotifyUrl               String?
  twitterUrl               String?
  websiteUrl               String?
  youtubeUrl               String?
  events                   Event[]
  followers                Follow[]
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TicketingType {
  AFTERS
  POSH
  DICE
  TICKETMASTER
  LIVENATION
  EVENTBRITE
  OTHER
}

model Event {
  id                   String           @id @default(cuid())
  organizerId          String
  title                String
  slug                 String
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String           @default("America/New_York")
  venueName            String
  venueAddress         String
  city                 String
  state                String?
  country              String           @default("US")
  flyerUrl             String?
  status               EventStatus      @default(DRAFT)
  isPublished          Boolean          @default(false)
  ageRestriction       Int?
  ticketingType        TicketingType    @default(AFTERS)
  externalTicketingUrl String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organizer            OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  views                EventView[]
  orders               Order[]
  savedBy              SavedEvent[]
  tickets              Ticket[]
  ticketTiers          TicketTier[]

  @@unique([organizerId, slug])
  @@index([city, startsAt])
  @@index([status, isPublished])
}

model TicketTier {
  id           String      @id @default(cuid())
  eventId      String
  name         String
  description  String?
  price        Int
  quantity     Int
  quantitySold Int         @default(0)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  minPerOrder  Int         @default(1)
  maxPerOrder  Int         @default(10)
  sortOrder    Int         @default(0)
  isVisible    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  tickets      Ticket[]
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String
  eventId               String
  subtotal              Int
  platformFee           Int
  stripeFee             Int
  total                 Int
  stripePaymentIntentId String?     @unique
  stripeChargeId        String?
  status                OrderStatus @default(PENDING)
  email                 String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paidAt                DateTime?
  event                 Event       @relation(fields: [eventId], references: [id])
  user                  User        @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  tickets               Ticket[]

  @@index([userId])
  @@index([eventId])
  @@index([stripePaymentIntentId])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  ticketTierId String
  quantity     Int
  unitPrice    Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id])

  @@index([orderId])
}

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  orderId      String
  eventId      String
  ticketTierId String
  userId       String
  qrCodeUrl    String?
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?
  checkedInBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier   @relation(fields: [ticketTierId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([orderId])
  @@index([ticketNumber])
}

model EventView {
  id        String   @id @default(cuid())
  eventId   String
  visitorId String?
  userAgent String?
  referrer  String?
  country   String?
  city      String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId])
}

model Follow {
  id          String           @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime         @default(now())
  follower    User             @relation(fields: [followerId], references: [id], onDelete: Cascade)
  following   OrganizerProfile @relation(fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  REFUNDED
}
