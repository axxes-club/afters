generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPERADMIN
  ORGANIZER
  ARTIST
  PERSONAL
}

model User {
  id               String            @id
  email            String            @unique
  username         String?           @unique
  firstName        String?
  lastName         String?
  imageUrl         String?
  bio              String?
  role             UserRole          @default(USER)
  isFaux           Boolean           @default(false) // Fake users for demo/testing
  isFlagged        Boolean           @default(false) // Superadmin internal flag (not visible to user)
  flaggedAt        DateTime?
  flaggedBy        String?
  flagReason       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  follows          Follow[]
  orders           Order[]
  organizerProfile OrganizerProfile?
  artistProfile    ArtistProfile?
  personalProfile  PersonalProfile?
  savedEvents      SavedEvent[]
  tickets          Ticket[]
  staffMemberships StaffMember[]

  @@index([isFlagged])
}

// Personal profile for regular users (/p/<username>)
model PersonalProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  slug         String   @unique
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  websiteUrl   String?
  twitterUrl   String?
  instagramUrl String?
  isPublic     Boolean  @default(true)
  isFaux       Boolean  @default(false) // Fake profile for demo/testing
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Artist profile for DJs/producers (/a/<slug>)
model ArtistProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  artistName     String
  slug           String        @unique
  bio            String?
  avatarUrl      String?
  coverUrl       String?
  genres         String?

  // Social Links
  spotifyUrl     String?
  soundcloudUrl  String?
  instagramUrl   String?
  twitterUrl     String?
  websiteUrl     String?
  youtubeUrl     String?
  tiktokUrl      String?
  bandcampUrl    String?
  beatportUrl    String?
  appleMusicUrl  String?

  // Customization
  accentColor    String?       // Custom accent color (hex)
  headerStyle    String?       // 'default', 'gradient', 'image', 'minimal'
  showPlayCount  Boolean       @default(true)
  showUpcoming   Boolean       @default(true)
  tagline        String?       // Short tagline/quote
  location       String?       // City, Country
  bookingEmail   String?       // For booking inquiries
  pressKitUrl    String?       // Link to press kit
  riderUrl       String?       // Link to tech rider

  // Additional Info
  label          String?       // Record label
  management     String?       // Management company
  agency         String?       // Booking agency

  isVerified     Boolean       @default(false)
  isFaux         Boolean       @default(false) // Fake profile for demo/testing
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  radioTracks    RadioTrack[]
}



// AFTERS RADIO Models
enum RadioTrackStatus {
  PENDING
  APPROVED
  REJECTED
}

model RadioTrack {
  id              String           @id @default(cuid())
  artistId        String?
  title           String
  artistName      String?          // For admin-uploaded tracks without artist profile
  fileUrl         String
  duration        Int              // Duration in seconds
  artworkUrl      String?
  genre           String?
  bpm             Int?
  status          RadioTrackStatus @default(PENDING)
  queuePosition   Int?             // Position in the radio queue (null = not in queue)
  rejectionReason String?
  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  uploadedBy      String?          // Admin who uploaded the track
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  artist          ArtistProfile?   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  plays           RadioPlay[]

  @@index([status])
  @@index([artistId])
  @@index([queuePosition])
}

model RadioPlay {
  id        String     @id @default(cuid())
  trackId   String
  playedAt  DateTime
  listeners Int        @default(1)
  createdAt DateTime   @default(now())
  track     RadioTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, playedAt])
  @@index([playedAt])
}

// Radio schedule for synchronized playback
model RadioSchedule {
  id           String   @id @default(cuid())
  dayOfWeek    Int      // 0-6 (Sunday-Saturday)
  startTime    String   // HH:mm format
  trackOrder   String[] // Array of track IDs in order
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([dayOfWeek, startTime])
}

enum FeatureType {
  EVENTS
  DASHBOARD
  LOGIN
  REGISTRATION
  TICKETING
  PROFILE
  PAYMENTS
  API
}

model SystemStatus {
  id          String       @id @default(cuid())
  feature     String
  featureType FeatureType
  status      SystemHealth @default(OPERATIONAL)
  message     String?
  plannedEnd  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([feature, featureType])
}

enum SystemHealth {
  OPERATIONAL
  MAINTENANCE
  DEPRECATED
  CONSTRUCTION
  DEPLOYING
  DOWN
}

model OrganizerProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  displayName              String
  slug                     String   @unique
  bio                      String?
  logoUrl                  String?
  stripeAccountId          String?  @unique
  stripeOnboardingComplete Boolean  @default(false)
  stripeChargesEnabled     Boolean  @default(false)
  stripePayoutsEnabled     Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  artistType               String?
  coverUrl                 String?
  genres                   String?
  instagramUrl             String?
  soundcloudUrl            String?
  spotifyUrl               String?
  twitterUrl               String?
  websiteUrl               String?
  youtubeUrl               String?
  events                   Event[]
  followers                Follow[]
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription             Subscription?
  staffMembers             StaffMember[]
  staffInvites             StaffInvite[]
}

enum TicketingType {
  AFTERS
  POSH
  DICE
  TICKETMASTER
  LIVENATION
  EVENTBRITE
  OTHER
}

model Event {
  id                   String           @id @default(cuid())
  organizerId          String
  title                String
  slug                 String
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String           @default("America/New_York")
  venueName            String
  venueAddress         String
  city                 String
  state                String?
  country              String           @default("US")
  flyerUrl             String?
  status               EventStatus      @default(DRAFT)
  isPublished          Boolean          @default(false)
  ageRestriction       Int?
  ticketingType        TicketingType    @default(AFTERS)
  externalTicketingUrl String?
  isFlagged            Boolean          @default(false) // Superadmin internal flag (not visible to organizer)
  flaggedAt            DateTime?
  flaggedBy            String?
  flagReason           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organizer            OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  views                EventView[]
  orders               Order[]
  savedBy              SavedEvent[]
  tickets              Ticket[]
  ticketTiers          TicketTier[]
  scanners             EventScanner[]
  scanLogs             ScanLog[]

  @@unique([organizerId, slug])
  @@index([city, startsAt])
  @@index([isFlagged])
  @@index([status, isPublished])
}

model TicketTier {
  id           String      @id @default(cuid())
  eventId      String
  name         String
  description  String?
  price        Int
  quantity     Int
  quantitySold Int         @default(0)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  minPerOrder  Int         @default(1)
  maxPerOrder  Int         @default(10)
  sortOrder    Int         @default(0)
  isVisible    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  tickets      Ticket[]
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String
  eventId               String
  subtotal              Int
  platformFee           Int
  stripeFee             Int
  total                 Int
  stripePaymentIntentId String?     @unique
  stripeChargeId        String?
  status                OrderStatus @default(PENDING)
  email                 String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paidAt                DateTime?
  event                 Event       @relation(fields: [eventId], references: [id])
  user                  User        @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  tickets               Ticket[]

  @@index([userId])
  @@index([eventId])
  @@index([stripePaymentIntentId])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  ticketTierId String
  quantity     Int
  unitPrice    Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id])

  @@index([orderId])
}

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  orderId      String
  eventId      String
  ticketTierId String
  userId       String
  qrCodeUrl    String?
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?
  checkedInBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier   @relation(fields: [ticketTierId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  scanLogs     ScanLog[]

  @@index([eventId])
  @@index([orderId])
  @@index([ticketNumber])
}

model EventView {
  id        String   @id @default(cuid())
  eventId   String
  visitorId String?
  userAgent String?
  referrer  String?
  country   String?
  city      String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId])
}

model Follow {
  id          String           @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime         @default(now())
  follower    User             @relation(fields: [followerId], references: [id], onDelete: Cascade)
  following   OrganizerProfile @relation(fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  REFUNDED
}

// Translation strings for CMS editing
model Translation {
  id        String   @id @default(cuid())
  locale    String   // en, es-ES, es-LA, pt-BR
  namespace String   // common, nav, events, tickets, etc.
  key       String   // The translation key
  value     String   @db.Text // The translated string
  updatedBy String?  // User ID who last updated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@index([locale])
  @@index([namespace])
}

// Verification request for artists/organizations
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationRequest {
  id              String             @id @default(cuid())
  artistProfileId String?
  organizationId  String?
  userId          String
  status          VerificationStatus @default(PENDING)

  // Verification evidence
  realName        String?            // Legal name
  socialProof     String?            // Links to verified social accounts
  pressLinks      String?            // Links to press coverage
  additionalInfo  String?            @db.Text

  // Review
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([artistProfileId])
  @@index([userId])
}

// ─── Subscription & Staff Management ───

enum Plan {
  FREE
  SIGNATURE_TRIAL_7D
  SIGNATURE_30D
  SIGNATURE_180D
  SIGNATURE_360D
  SIGNATURE_FF
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  organizerProfileId   String             @unique
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripePriceId        String?
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organizerProfile     OrganizerProfile   @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
}

enum StaffRole {
  ADMIN
  SCANNER
  EDITOR
  SUPPORT
  FINANCE
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model StaffMember {
  id                 String           @id @default(cuid())
  organizerProfileId String
  userId             String
  role               StaffRole        @default(SCANNER)
  customPermissions  String[]
  invitedBy          String
  status             StaffStatus      @default(ACTIVE)
  addedAt            DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerProfileId, userId])
  @@index([organizerProfileId])
  @@index([userId])
}

model StaffInvite {
  id                 String           @id @default(cuid())
  organizerProfileId String
  email              String
  role               StaffRole        @default(SCANNER)
  token              String           @unique @default(cuid())
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedBy         String?
  createdAt          DateTime         @default(now())
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  @@index([organizerProfileId])
  @@index([token])
  @@index([email])
}

// ─── Beta Program ───

model BetaEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  city      String
  state     String
  instagram String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([state])
}

// ─── Scanner Security System ───

enum ScanResult {
  SUCCESS
  ALREADY_CHECKED_IN
  INVALID_TICKET
  CANCELLED_TICKET
  WRONG_EVENT
}

model EventScanner {
  id        String         @id @default(cuid())
  eventId   String
  name      String
  code      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanLogs  ScanLog[]
  shifts    ScannerShift[]

  @@unique([eventId, code])
  @@index([eventId])
  @@index([code])
}

model ScanLog {
  id           String       @id @default(cuid())
  eventId      String
  scannerId    String
  ticketId     String?
  ticketNumber String?
  result       ScanResult
  message      String?
  scannedAt    DateTime     @default(now())
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanner      EventScanner @relation(fields: [scannerId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([scannerId])
  @@index([ticketId])
}

model ScannerShift {
  id           String       @id @default(cuid())
  scannerId    String
  punchedInAt  DateTime     @default(now())
  punchedOutAt DateTime?
  scanner      EventScanner @relation(fields: [scannerId], references: [id], onDelete: Cascade)

  @@index([scannerId])
  @@index([punchedInAt])
}
