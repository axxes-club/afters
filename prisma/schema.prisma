generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPERADMIN
  ORGANIZER
  ARTIST
  PERSONAL
}

model User {
  id               String            @id
  email            String            @unique
  username         String?           @unique
  firstName        String?
  lastName         String?
  imageUrl         String?
  bio              String?
  role             UserRole          @default(ORGANIZER)
  isFaux           Boolean           @default(false) // Fake users for demo/testing
  isFlagged        Boolean           @default(false) // Superadmin internal flag (not visible to user)
  flaggedAt        DateTime?
  flaggedBy        String?
  flagReason       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  organizerProfile OrganizerProfile?
  artistProfile    ArtistProfile?
  personalProfile  PersonalProfile?
  savedEvents      SavedEvent[]
  tickets          Ticket[]
  staffMemberships StaffMember[]
  activities              UserActivity[]
  apiKeys                 ApiKey[]
  notificationPreference  NotificationPreference?
  pushSubscriptions       PushSubscription[]
  oauthApps               OAuthApp[]
  oauthAuthCodes          OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthConnections        OAuthConnection[]
  vibezPosts              VibezPost[]

  @@index([isFlagged])
}

// API Keys for programmatic access
model ApiKey {
  id             String    @id @default(cuid())
  userId         String
  name           String    // User-friendly name for the key
  keyPrefix      String    // First 8 chars of key for identification (e.g., "aftr_abc1")
  keyHash        String    @unique // SHA-256 hash of the full key
  scopes         String[]  // Permissions: ["events:read", "events:write", "orders:read", etc.]
  lastUsedAt     DateTime?
  expiresAt      DateTime? // Optional expiration
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
}

// Notification Preferences for email and push notifications
model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Email preferences
  emailTicketSales      Boolean  @default(true)
  emailEventReminders   Boolean  @default(true)
  emailCheckInSummaries Boolean  @default(false)
  emailProductUpdates   Boolean  @default(false)

  // Push preferences
  pushTicketSales       Boolean  @default(true)
  pushEventReminders    Boolean  @default(true)
  pushCheckInSummaries  Boolean  @default(false)
  pushProductUpdates    Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Push subscription for browser push notifications
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Personal profile for regular users (/p/<username>)
model PersonalProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  slug         String   @unique
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  websiteUrl   String?
  twitterUrl   String?
  instagramUrl String?
  isPublic     Boolean  @default(true)
  isFaux       Boolean  @default(false) // Fake profile for demo/testing
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Artist profile for DJs/producers (/a/<slug>)
model ArtistProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  artistName     String
  slug           String        @unique
  bio            String?
  avatarUrl      String?
  coverUrl       String?
  genres         String?

  // Social Links
  spotifyUrl     String?
  soundcloudUrl  String?
  instagramUrl   String?
  twitterUrl     String?
  websiteUrl     String?
  youtubeUrl     String?
  tiktokUrl      String?
  bandcampUrl    String?
  beatportUrl    String?
  appleMusicUrl  String?

  // Customization
  accentColor    String?       // Custom accent color (hex)
  headerStyle    String?       // 'default', 'gradient', 'image', 'minimal'
  showPlayCount  Boolean       @default(true)
  showUpcoming   Boolean       @default(true)
  tagline        String?       // Short tagline/quote
  location       String?       // City, Country
  bookingEmail   String?       // For booking inquiries
  pressKitUrl    String?       // Link to press kit
  riderUrl       String?       // Link to tech rider

  // Additional Info
  label          String?       // Record label
  management     String?       // Management company
  agency         String?       // Booking agency

  isVerified     Boolean       @default(false)
  isFaux         Boolean       @default(false) // Fake profile for demo/testing
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  radioTracks    RadioTrack[]
}



// AFTERS RADIO Models
enum RadioTrackStatus {
  PENDING
  APPROVED
  REJECTED
}

model RadioTrack {
  id              String           @id @default(cuid())
  artistId        String?
  title           String
  artistName      String?          // For admin-uploaded tracks without artist profile
  fileUrl         String
  duration        Int              // Duration in seconds
  artworkUrl      String?
  genre           String?
  bpm             Int?
  status          RadioTrackStatus @default(PENDING)
  queuePosition   Int?             // Position in the radio queue (null = not in queue)
  rejectionReason String?
  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  uploadedBy      String?          // Admin who uploaded the track
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  artist          ArtistProfile?   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  plays           RadioPlay[]

  @@index([status])
  @@index([artistId])
  @@index([queuePosition])
}

model RadioPlay {
  id        String     @id @default(cuid())
  trackId   String
  playedAt  DateTime
  listeners Int        @default(1)
  createdAt DateTime   @default(now())
  track     RadioTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, playedAt])
  @@index([playedAt])
}

// Radio schedule for synchronized playback
model RadioSchedule {
  id           String   @id @default(cuid())
  dayOfWeek    Int      // 0-6 (Sunday-Saturday)
  startTime    String   // HH:mm format
  trackOrder   String[] // Array of track IDs in order
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([dayOfWeek, startTime])
}

enum FeatureType {
  EVENTS
  DASHBOARD
  LOGIN
  REGISTRATION
  TICKETING
  PROFILE
  PAYMENTS
  API
}

model SystemStatus {
  id          String       @id @default(cuid())
  feature     String
  featureType FeatureType
  status      SystemHealth @default(OPERATIONAL)
  message     String?
  plannedEnd  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([feature, featureType])
}

enum SystemHealth {
  OPERATIONAL
  MAINTENANCE
  DEPRECATED
  CONSTRUCTION
  DEPLOYING
  DOWN
}

model OrganizerProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  displayName              String
  slug                     String   @unique
  bio                      String?
  logoUrl                  String?
  stripeAccountId          String?  @unique
  stripeOnboardingComplete Boolean  @default(false)
  stripeChargesEnabled     Boolean  @default(false)
  stripePayoutsEnabled     Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  artistType               String?
  coverUrl                 String?
  genres                   String?
  instagramUrl             String?
  soundcloudUrl            String?
  spotifyUrl               String?
  twitterUrl               String?
  websiteUrl               String?
  youtubeUrl               String?
  events                   Event[]
  eventSeries              EventSeries[]
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription             Subscription?
  staffMembers             StaffMember[]
  staffInvites             StaffInvite[]

  // Past artists used in lineups - auto-populated when events are published
  // [{name, role?, imageUrl?, socialUrl?, usedCount, lastUsedAt}]
  pastArtists              Json?

  // Aftie AI Image Generation Settings
  aftieImageProvider       String?  // 'openai' | 'gemini' | null
  aftieImageApiKey         String?  // User's API key for image generation (TODO: encrypt at rest)

  // UI Customization Preferences
  sidebarLogoMode          String   @default("afters3x") // 'afters' | 'afters3x' | 'custom' | 'hidden'
  sidebarCustomLogoUrl     String?  // URL for custom logo when sidebarLogoMode = 'custom'
  sidebarCompact           Boolean  @default(false) // Compact sidebar mode
  uiAccentColor            String?  // Custom accent color for dashboard UI
  uiFontSize               String   @default("normal") // 'small' | 'normal' | 'large'
}

enum TicketingType {
  AFTERS
  POSH
  DICE
  TICKETMASTER
  LIVENATION
  EVENTBRITE
  OTHER
}

// Event Series for recurring events
model EventSeries {
  id              String            @id @default(cuid())
  organizerId     String
  title           String            // Series name, e.g. "Techno Tuesdays"
  recurrenceRule  String            // RRULE string (RFC 5545), e.g. "FREQ=WEEKLY;BYDAY=TU"
  timezone        String            @default("America/New_York")
  templateData    Json?             // Shared defaults: venue, theme, lineup, ticket tiers, etc.
  startsAt        DateTime          // When the series begins
  endsAt          DateTime?         // Optional: when the series ends (null = indefinite)
  maxOccurrences  Int?              // Optional: max number of occurrences
  lastGeneratedAt DateTime?         // When occurrences were last generated
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organizer       OrganizerProfile  @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  events          Event[]

  @@index([organizerId])
}

model Event {
  id                   String           @id @default(cuid())
  organizerId          String
  title                String
  slug                 String
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String           @default("America/New_York")
  venueName            String
  venueAddress         String
  city                 String
  state                String?
  country              String           @default("US")
  flyerUrl             String?
  status               EventStatus      @default(DRAFT)
  isPublished          Boolean          @default(false)
  ageRestriction       Int?
  ticketingType        TicketingType    @default(AFTERS)
  externalTicketingUrl String?
  
  // Series/Recurring event fields
  seriesId             String?
  seriesOccurrence     Int?              // Which occurrence in the series (1, 2, 3...)
  isSeriesOverride     Boolean           @default(false) // True if this occurrence was customized
  series               EventSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  
  // Underground event features
  isAddressHidden      Boolean          @default(false) // Hide address until ticket purchase
  lineup               Json?            // Array of artists: [{name, role?, imageUrl?, socialUrl?}]
  gallery              Json?            // Array of image URLs for event gallery
  pageTheme            String           @default("neon") // 'brutalist', 'neon', 'minimal', 'tilt', 'editorial'
  accentColor          String?          // Custom accent color (hex) for buttons/highlights
  backgroundColor      String?          // Custom background color (hex) for page background
  typography           String           @default("headline") // 'mono', 'headline', 'elegant', 'modern'
  scannerSound         String           @default("basic") // 'basic', 'lasersword', 'pewpew', 'farts', 'ding', 'cashregister'
  hasGuestlist         Boolean          @default(false) // Enable guestlist for this event

  // Event type: TICKETED vs RSVP
  isRsvpOnly           Boolean          @default(false) // True = RSVP event, False = Ticketed event
  rsvpCapacity         Int?             // Max RSVPs allowed (null = unlimited)
  rsvpAllowPlusOnes    Boolean          @default(false) // Allow guests to bring +1s
  rsvpMaxPlusOnes      Int              @default(1) // Max +1s per RSVP
  rsvpCount            Int              @default(0) // Current RSVP count
  showRsvpCount        Boolean          @default(false) // Show RSVP count on event page

  // Location Broadcasting Settings (exclusivity controls)
  showLocationOnPage   Boolean          @default(false) // Show location on public event page
  showLocationOnTicket Boolean          @default(true)  // Show location on purchased ticket
  showMapOnPage        Boolean          @default(false) // Show map on public event page
  showMapOnTicket      Boolean          @default(false) // Show map on ticket
  broadcastOnStart     Boolean          @default(false) // Email location when event starts
  locationPrecision    String           @default("exact") // 'exact', 'area', 'city' - how precise to show

  // Map Customization Settings
  mapZoom              Int              @default(15)     // Default zoom level (1-20)
  mapStyle             String           @default("dark") // 'dark', 'light', 'satellite', 'streets', 'minimal'
  mapShowPin           Boolean          @default(true)   // Show location pin
  mapShowRadius        Boolean          @default(false)  // Show radius circle around location
  mapRadiusMeters      Int              @default(500)    // Radius size in meters
  mapBlurLevel         Int              @default(0)      // Blur level (0 = no blur, 1-10)
  mapUnblurOnStart     Boolean          @default(false)  // Gradually unblur as event approaches
  mapLat               Float?                            // Custom latitude
  mapLng               Float?                            // Custom longitude
  mapDoodles           Json?                             // Array of doodle/annotation data

  // Event Information Sections
  about                String?          @db.Text // Detailed "About" section
  refundPolicy         String?          @db.Text // Refund/cancellation policy
  faqs                 Json?            // Array of FAQ objects: [{question, answer}]

  isFlagged            Boolean          @default(false) // Superadmin internal flag (not visible to organizer)
  flaggedAt            DateTime?
  flaggedBy            String?
  flagReason           String?

  // Event expiration settings
  expiresAfter         String           @default("6h") // 'on_end', '6h', '12h', '24h', '48h', '1w', 'never'

  // VIBEZ (BETA): social feed for attendees during the event
  vibezEnabled         Boolean          @default(false)

  // Reschedule tracking fields
  previousStartsAt     DateTime?        // Previous start date (set when rescheduled)
  previousEndsAt       DateTime?        // Previous end date (set when rescheduled)
  rescheduledAt        DateTime?        // When the event was last rescheduled

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organizer            OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  views                EventView[]
  orders               Order[]
  savedBy              SavedEvent[]
  tickets              Ticket[]
  ticketTiers          TicketTier[]
  scanners             EventScanner[]
  scanLogs             ScanLog[]
  guestlistEntries     GuestlistEntry[]
  rsvps                Rsvp[]
  slugRedirects        EventSlugRedirect[]
  changeLogs           EventChangeLog[]
  vibezPosts           VibezPost[]
  vibezBans            VibezBan[]

  @@unique([organizerId, slug])
  @@index([city, startsAt])
  @@index([isFlagged])
  @@index([status, isPublished])
  @@index([seriesId])
}

// Slug redirect for old event URLs (when title is renamed)
model EventSlugRedirect {
  id        String   @id @default(cuid())
  eventId   String
  oldSlug   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, oldSlug])
  @@index([oldSlug])
}

// Audit log for event changes (title, dates)
model EventChangeLog {
  id        String   @id @default(cuid())
  eventId   String
  field     String   // "title", "startsAt", "endsAt", "slug"
  oldValue  String
  newValue  String
  changedBy String   // User ID who made the change
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
}

model TicketTier {
  id           String      @id @default(cuid())
  eventId      String
  name         String
  description  String?
  price        Int
  quantity     Int
  quantitySold Int         @default(0)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  minPerOrder  Int         @default(1)
  maxPerOrder  Int         @default(10)
  sortOrder    Int         @default(0)
  isVisible    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  tickets      Ticket[]
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String?     // Optional - null for guest checkout
  eventId               String
  subtotal              Int
  platformFee           Int
  stripeFee             Int
  total                 Int
  stripePaymentIntentId String?     @unique
  stripeChargeId        String?
  status                OrderStatus @default(PENDING)
  email                 String
  guestName             String?     // Name for guest checkout
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paidAt                DateTime?
  event                 Event       @relation(fields: [eventId], references: [id])
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  tickets               Ticket[]

  @@index([userId])
  @@index([eventId])
  @@index([stripePaymentIntentId])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  ticketTierId String
  quantity     Int
  unitPrice    Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id])

  @@index([orderId])
}

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  orderId      String
  eventId      String
  ticketTierId String
  userId       String?      // Optional - null for guest checkout
  qrCodeUrl    String?
  status       TicketStatus @default(VALID)
  isTestTicket Boolean      @default(false) // Test ticket for organizer testing
  checkedInAt  DateTime?
  checkedInBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier   @relation(fields: [ticketTierId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  scanLogs     ScanLog[]

  @@index([eventId])
  @@index([orderId])
  @@index([ticketNumber])
}

// Guestlist for VIP/comp entries (separate from paid tickets)
model GuestlistEntry {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  phone       String?
  email       String?
  plusOnes    Int       @default(0) // Number of additional guests allowed
  notes       String?   // Internal notes (e.g., "VIP", "Artist +1")
  addedBy     String    // User ID who added this entry
  checkedInAt DateTime?
  checkedInBy String?   // Scanner ID who checked them in
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([phone])
}

// VIBEZ (BETA): attendee social feed posts during the event
model VibezPost {
  id          String   @id @default(cuid())
  eventId     String
  userId      String?  // Optional: null for guest checkout attendees who don't have account
  authorName  String   // Display name (from user profile or guest name)
  authorImageUrl String? // Avatar URL
  imageUrl    String   // The posted image
  /// A moderator removed this. The row stays so the storage URL can be purged.
  removedAt   DateTime?
  removedBy   String?  // Clerk user id of whoever removed it
  removedReason String?
  /// Open reports against this post, surfaced to moderators for triage.
  reportCount Int      @default(0)
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports     VibezReport[]

  @@index([eventId])
  @@index([eventId, createdAt])
  @@index([eventId, removedAt])
}

/// Someone flagged a post. One row per person per post.
model VibezReport {
  id         String   @id @default(cuid())
  postId     String
  reporterId String   // Clerk user id
  reason     String   @default("other")
  note       String?
  createdAt  DateTime @default(now())
  post       VibezPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([postId])
}

/// Someone who may not post in an event's feed again. Scoped per event, so a
/// ban at one event never follows them to the next.
model VibezBan {
  id        String   @id @default(cuid())
  eventId   String
  userId    String   // Clerk user id
  bannedBy  String   // Clerk user id of the moderator
  reason    String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// RSVP entries for RSVP-only events
model Rsvp {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  email       String
  phone       String?
  plusOnes    Int       @default(0) // Number of +1s they're bringing
  message     String?   // Optional message from guest
  status      RsvpStatus @default(CONFIRMED)
  checkedInAt DateTime?
  checkedInBy String?   // Scanner ID who checked them in
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
}

enum RsvpStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  CHECKED_IN
}

model EventView {
  id        String   @id @default(cuid())
  eventId   String
  visitorId String?
  userAgent String?
  referrer  String?
  country   String?
  city      String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  REFUNDED
}

// Translation strings for CMS editing
model Translation {
  id        String   @id @default(cuid())
  locale    String   // en, es-ES, es-LA, pt-BR
  namespace String   // common, nav, events, tickets, etc.
  key       String   // The translation key
  value     String   @db.Text // The translated string
  updatedBy String?  // User ID who last updated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@index([locale])
  @@index([namespace])
}

// Verification request for artists/organizations
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationRequest {
  id              String             @id @default(cuid())
  artistProfileId String?
  organizationId  String?
  userId          String
  status          VerificationStatus @default(PENDING)

  // Verification evidence
  realName        String?            // Legal name
  socialProof     String?            // Links to verified social accounts
  pressLinks      String?            // Links to press coverage
  additionalInfo  String?            @db.Text

  // Review
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([artistProfileId])
  @@index([userId])
}

// ─── Subscription & Staff Management ───

enum Plan {
  FREE
  SIGNATURE_TRIAL_7D
  SIGNATURE_30D
  SIGNATURE_180D
  SIGNATURE_360D
  SIGNATURE_FF
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  organizerProfileId   String             @unique
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripePriceId        String?
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organizerProfile     OrganizerProfile   @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
}

enum StaffRole {
  ADMIN
  SCANNER
  EDITOR
  SUPPORT
  FINANCE
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model StaffMember {
  id                 String           @id @default(cuid())
  organizerProfileId String
  userId             String
  role               StaffRole        @default(SCANNER)
  customPermissions  String[]
  invitedBy          String
  status             StaffStatus      @default(ACTIVE)
  addedAt            DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerProfileId, userId])
  @@index([organizerProfileId])
  @@index([userId])
}

model StaffInvite {
  id                 String           @id @default(cuid())
  organizerProfileId String
  email              String
  role               StaffRole        @default(SCANNER)
  token              String           @unique @default(cuid())
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedBy         String?
  createdAt          DateTime         @default(now())
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  @@index([organizerProfileId])
  @@index([token])
  @@index([email])
}

// ─── Beta Program ───

model BetaEntry {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  city      String
  state     String
  instagram String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([state])
}

// ─── Scanner Security System ───

enum ScanResult {
  SUCCESS
  ALREADY_CHECKED_IN
  INVALID_TICKET
  CANCELLED_TICKET
  WRONG_EVENT
}

model EventScanner {
  id          String         @id @default(cuid())
  eventId     String
  name        String
  code        String
  email       String?        // Optional email for sending scanner credentials
  emailSentAt DateTime?      // When credentials were last sent
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanLogs    ScanLog[]
  shifts      ScannerShift[]

  @@unique([eventId, code])
  @@index([eventId])
  @@index([code])
}

model ScanLog {
  id           String       @id @default(cuid())
  eventId      String
  scannerId    String
  ticketId     String?
  ticketNumber String?
  result       ScanResult
  message      String?
  scannedAt    DateTime     @default(now())
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanner      EventScanner @relation(fields: [scannerId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([scannerId])
  @@index([ticketId])
}

model ScannerShift {
  id           String       @id @default(cuid())
  scannerId    String
  punchedInAt  DateTime     @default(now())
  punchedOutAt DateTime?
  scanner      EventScanner @relation(fields: [scannerId], references: [id], onDelete: Cascade)

  @@index([scannerId])
  @@index([punchedInAt])
}

// ─── Site Settings (singleton) ───

model SiteSettings {
  id                 String   @id @default("singleton")
  radioWidgetEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── User Activity Logging (Superadmin) ───

model UserActivity {
  id         String   @id @default(cuid())
  userId     String
  action     String   // 'login', 'page_view', 'event_create', 'event_edit', 'ticket_purchase', etc.
  path       String?  // URL path
  metadata   Json?    // Additional action-specific data
  userAgent  String?
  ipAddress  String?
  sessionId  String?  // Group actions by session
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([action, createdAt])
}

// ─── User Feedback ───

model Feedback {
  id             String   @id @default(cuid())
  userId         String?  // Optional - can be anonymous
  type           String   // 'bug', 'feature', 'general'
  message        String
  screenshotUrl  String?  // Uploaded screenshot
  activityLog    Json?    // Cached user activity at time of submission
  currentPath    String?  // Page they were on
  userAgent      String?
  status         String   @default("new") // 'new', 'reviewed', 'resolved', 'wontfix'
  adminNotes     String?
  githubIssueUrl String?  // Link to GitHub issue if created
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ─── OAuth 2.0 Models ───

model OAuthApp {
  id           String   @id @default(cuid())
  name         String
  description  String?
  clientId     String   @unique @default(cuid())
  clientSecret String   // hashed
  redirectUris String[] // Array of allowed redirect URIs
  scopes       String[] // Array of allowed scopes
  logoUrl      String?
  websiteUrl   String?
  privacyUrl   String?
  termsUrl     String?
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false) // For verified/trusted apps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Owner
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relations
  authCodes    OAuthAuthorizationCode[]
  accessTokens OAuthAccessToken[]
  connections  OAuthConnection[]

  @@index([userId])
  @@index([clientId])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  code                String    @unique
  appId               String
  userId              String
  scopes              String[]
  redirectUri         String
  codeChallenge       String?   // PKCE
  codeChallengeMethod String?   // plain or S256
  state               String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())
  
  app  OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([appId])
  @@index([userId])
}

model OAuthAccessToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  tokenPrefix      String    // First 8 chars for identification
  appId            String
  userId           String
  scopes           String[]
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  
  // Refresh token (stored together)
  refreshTokenHash String?   @unique
  refreshExpiresAt DateTime?
  
  app  OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tokenPrefix])
  @@index([refreshTokenHash])
  @@index([appId])
  @@index([userId])
}

model OAuthConnection {
  id        String   @id @default(cuid())
  appId     String
  userId    String
  scopes    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  app  OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
  @@index([userId])
}
