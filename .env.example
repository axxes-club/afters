# Database (Neon)
DATABASE_URL="postgresql://..."

# Clerk (https://dashboard.clerk.com/last-active?path=api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY
CLERK_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UploadThing (https://uploadthing.com/)
UPLOADTHING_SECRET=YOUR_UPLOADTHING_SECRET
UPLOADTHING_APP_ID=YOUR_UPLOADTHING_APP_ID

# Email (Resend - https://resend.com)
# Required for sending ticket emails after purchase
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Scanner Authentication
SCANNER_JWT_SECRET=your-scanner-jwt-secret-here

# AI (Groq - for AFTIE chat)
# Get your API key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# Note: Image generation for AFTIE is configured per-user in Settings > Aftie
# Users can connect their own OpenAI or Gemini API keys

# Apple Wallet passes (optional - "Add to Apple Wallet" is hidden until all are set)
# Pass Type ID + certificate from https://developer.apple.com/account/resources/identifiers/passTypeId
# Cert/key/WWDR values accept raw PEM or base64-encoded PEM (base64 is easiest for Vercel)
APPLE_PASS_TYPE_ID=pass.am.afters.ticket
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
# Apple WWDR G4 intermediate: https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
APPLE_WALLET_WWDR=
# Signs the "Add to Apple Wallet" links in emails (falls back to SCANNER_JWT_SECRET)
WALLET_LINK_SECRET=
