# ============================================
# Afters Docker Environment Configuration
# ============================================
# Copy this file to docker/.env.docker and fill in your values
# cp docker/.env.docker.example docker/.env.docker

# ============================================
# Database (auto-configured for Docker)
# ============================================
DATABASE_URL="postgresql://afters:afters@postgres:5432/afters"

# ============================================
# Clerk Authentication
# Get your keys at: https://dashboard.clerk.com/last-active?path=api-keys
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY
CLERK_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Clerk URLs (usually don't need to change)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ============================================
# Stripe
# Get your keys at: https://dashboard.stripe.com/apikeys
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# UploadThing (Image Uploads)
# Get your keys at: https://uploadthing.com/
# ============================================
UPLOADTHING_SECRET=YOUR_UPLOADTHING_SECRET
UPLOADTHING_APP_ID=YOUR_UPLOADTHING_APP_ID

# ============================================
# Email (Resend)
# Get your key at: https://resend.com
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ============================================
# Scanner Authentication
# ============================================
SCANNER_JWT_SECRET=your-scanner-jwt-secret-here

# ============================================
# AI (Groq - for AFTIE chat)
# Get your API key at: https://console.groq.com
# ============================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxx